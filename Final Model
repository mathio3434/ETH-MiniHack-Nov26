# ============================== HELPERS ==============================
class RateLimiter:
    """Sliding 1 s window of action timestamps, shared by all names."""

    def __init__(self, cap):
        self.cap = cap
        self.stamps = deque()

    def ok(self, n=1):
        now = time.time()
        while self.stamps and now - self.stamps[0] > 1.0:
            self.stamps.popleft()
        return len(self.stamps) + n <= self.cap

    def hit(self, n=1):
        now = time.time()
        for _ in range(n):
            self.stamps.append(now)


class Ewma:
    def __init__(self, halflife):
        self.alpha = 1 - 0.5 ** (1 / halflife)
        self.value = None

    def update(self, x):
        self.value = x if self.value is None else (1 - self.alpha) * self.value + self.alpha * x
        return self.value


def round_price(price, tick):
    return round(round(price / tick) * tick, 2)


def fmt(x):
    return "" if x is None else str(round(x, 4)) if isinstance(x, float) else str(x)


def _raise_interrupt(signum, frame):
    raise KeyboardInterrupt


# ============================== BOT ==============================
class MarketMaker:
    def __init__(self):
        self.ex = Exchange()
        self.ex.connect()
        self.limiter = RateLimiter(RATE_CAP)
        self.spreads = defaultdict(lambda: Ewma(SPREAD_HALFLIFE))
        self.own_avg = defaultdict(lambda: Ewma(BASIS_HALFLIFE))    # slow average of ln(follower micro)
        self.lead_avg = defaultdict(lambda: Ewma(BASIS_HALFLIFE))   # slow average of ln(leader micro)
        self.ticks = {}
        self.positions = None             # read once per loop
        self.books = {}                   # raw books, read once per loop (leaders are read by followers too)
        self.last_micro = {}              # own micro last loop (jump pause)
        self.last_lmicro = {}             # leader micro last loop, per follower (jump pause + glitch wait)
        self.pair_hist = defaultdict(deque)   # follower -> (time, ln follower, ln leader) over LEAD_WIN_S
        self.pause_until = defaultdict(float)
        self.last_pos = {}
        self.bad_loops = defaultdict(int)
        self.pnl = None
        self.pnl_peak = None
        self.pnl_warned = False
        self.disconnects = 0
        self.rotation = 0
        self.t_start = time.time()
        self.take_ids = set()             # our IOC order ids: tells take fills from make fills
        self.last_take = {}
        self.take_off = set()
        self.make_off = set()
        self.pending = defaultdict(deque) # fills waiting MARKOUT_S for their markout
        self.markouts = defaultdict(lambda: {"take": [], "make": []})
        self.last_report = time.time()
        self.exporter = Exporter()
        log.info("Connected to exchange.")

    # ---------------- market data (reads) ----------------
    def book(self, iid):
        """Raw book with both sides non-empty, else None. Cached for the current loop."""
        if iid not in self.books:
            b = None
            try:
                b = self.ex.get_last_price_book(iid)
                if not (b and b.bids and b.asks):
                    b = None
            except Exception as ex:
                log.error(f"book fetch failed {iid}: {ex}")
            self.books[iid] = b
        return self.books[iid]

    @staticmethod
    def clean_book(book, orders):
        """The book minus OUR resting volume, or None if a side empties. We quote inside the spread, so
        the raw best bid/ask is often our own order: left in, it corrupts micro, spread and fair value."""
        if book is None:
            return None
        mine = defaultdict(int)
        for o in orders.values():
            mine[(o.side, round(o.price, 2))] += o.volume

        def strip(levels, side):
            out = []
            for lv in levels:
                v = lv.volume - mine.get((side, round(lv.price, 2)), 0)
                if v > 0:
                    out.append(SimpleNamespace(price=lv.price, volume=v))
            return out

        bids, asks = strip(book.bids, "bid"), strip(book.asks, "ask")
        return SimpleNamespace(bids=bids, asks=asks) if bids and asks else None

    def refresh_positions(self):
        try:
            self.positions = self.ex.get_positions()
        except Exception as ex:
            log.error(f"get_positions failed: {ex}")
            self.positions = None

    def outstanding(self, iid):
        try:
            return dict(self.ex.get_outstanding_orders(iid))
        except Exception as ex:
            log.error(f"get_outstanding_orders {iid}: {ex}")
            return None

    def refresh_pnl(self):
        try:
            self.pnl = float(self.ex.get_pnl())
            if self.pnl_peak is None or self.pnl > self.pnl_peak:
                self.pnl_peak = self.pnl
        except Exception as ex:
            self.pnl = None
            if not self.pnl_warned:
                log.warning(f"get_pnl failed (drawdown kill disabled while it fails): {ex}")
                self.pnl_warned = True

    # ---------------- pricing ----------------
    @staticmethod
    def microprice(book):
        """Size-weighted top of book: leans toward the side with less size."""
        bid, bid_size = book.bids[0].price, book.bids[0].volume
        ask, ask_size = book.asks[0].price, book.asks[0].volume
        total = bid_size + ask_size
        return (bid + ask) / 2 if total <= 0 else (bid * ask_size + ask * bid_size) / total

    @staticmethod
    def inventory_shift(pos, tick):
        """Long -> positive -> quotes move down. tanh-shaped, MAX_SKEW_TICKS at the soft limit."""
        dev = pos - BASELINE
        room = (SOFT_POS_LIMIT - BASELINE) if dev > 0 else (SOFT_POS_LIMIT + BASELINE)
        if dev == 0 or room <= 0:
            return 0.0
        x = min(abs(dev) / room, 1.0)
        shape = math.tanh(SKEW_BETA * x) / math.tanh(SKEW_BETA)
        return math.copysign(MAX_SKEW_TICKS * tick * shape, dev)

    def fair_value(self, iid, micro):
        """Returns (fair, implied, lead_driven). No leader or no leader data -> (micro, None, False)."""
        p = PAIRS.get(iid)
        if not p:
            return micro, None, False
        lead = p["leader"]
        lraw = self.book(lead)
        if lraw is None:
            return micro, None, False
        lbook = self.clean_book(lraw, self.outstanding(lead) or {}) or lraw   # we quote the leader too
        lmicro = self.microprice(lbook)

        prev = self.last_lmicro.get(iid)
        self.last_lmicro[iid] = lmicro
        spike = bool(prev) and abs(lmicro / prev - 1) > JUMP_PULL_PCT
        if spike:
            self.pause_until[iid] = time.time() + JUMP_PAUSE_S
            log.warning(f"{iid}: leader {lead} {(lmicro / prev - 1) * 1e4:+.0f}bps in one loop "
                        f"-> quotes pulled {JUMP_PAUSE_S:g}s, no IOC this loop")

        b = p["beta"]
        lf, ll = math.log(micro), math.log(lmicro)
        mf = self.own_avg[iid].update(lf)
        ml = self.lead_avg[iid].update(ll)
        own_part = mf - lf                 # > 0: follower is below its own average
        lead_part = b * (ll - ml)          # > 0: leader is above its own average
        implied = math.exp(lf + own_part + lead_part)
        # who opened the gap? Judged on the LAST FEW SECONDS, not the slow averages: after a big leader move
        # the leader stays above its 5-min average for minutes, and a later follower-only move would wrongly
        # count as leader-driven (caught in testing).
        now = time.time()
        h = self.pair_hist[iid]
        h.append((now, lf, ll))
        while h and now - h[0][0] > LEAD_WIN_S:
            h.popleft()
        own_move = lf - h[0][1]                    # follower's own log move over the window
        lead_move = b * (ll - h[0][2])             # leader's log move over the window, x beta
        gap = own_part + lead_part                 # log(implied / micro): > 0 means follower is cheap
        lead_driven = (not spike and lead_move * gap > 0 and abs(lead_move) > abs(own_move))
        cap = MAX_LEAD_SHIFT_PCT * micro
        shift = max(-cap, min(cap, p["catchup"] * (implied - micro)))
        return micro + shift, implied, lead_driven

    def quote_prices(self, iid, fair, micro, pos, mkt_half, best_bid, best_ask, tick):
        half_mult = PAIRS.get(iid, {}).get("half_mult", HALF_SPREAD_MULT)
        half = max(half_mult * mkt_half, MIN_HALF_TICKS * tick)          # no vol term
        centre = fair - self.inventory_shift(pos, tick)
        # guard 1 (one-sided): never MORE aggressive than a band around micro. Further away is allowed:
        # clipping it back would put us on the wrong side of fair after a leader move.
        max_dev = max(MAX_DEV_MULT * mkt_half, 2 * tick)
        raw_bid = min(centre - half, micro + max_dev)
        raw_ask = max(centre + half, micro - max_dev)
        bid = round(math.floor(raw_bid / tick + EPS) * tick, 2)          # bid rounds down, ask up
        ask = round(math.ceil(raw_ask / tick - EPS) * tick, 2)
        bid = min(bid, round(best_ask - tick, 2))                       # guard 2: passive never crosses
        ask = max(ask, round(best_bid + tick, 2))
        if ask - bid < tick - EPS:                                       # guard 3: bid below ask
            ask = round(bid + tick, 2)
        return bid, ask

    @staticmethod
    def quote_sizes(pos):
        """A full fill still lands inside the soft limit."""
        return max(0, min(QUOTE_VOL, SOFT_POS_LIMIT - pos)), max(0, min(QUOTE_VOL, SOFT_POS_LIMIT + pos))

    # ---------------- limits ----------------
    @staticmethod
    def room(side, vol, pos, orders):
        """Largest volume <= vol that cannot breach position or outstanding-volume limits,
        assuming every resting same-side order fills too."""
        rest_bids = sum(o.volume for o in orders.values() if o.side == "bid")
        rest_asks = sum(o.volume for o in orders.values() if o.side == "ask")
        pos_room = POS_LIMIT - (pos + rest_bids) if side == "bid" else POS_LIMIT + (pos - rest_asks)
        vol_room = MAX_ORDER_VOLUME - (rest_bids + rest_asks)
        return max(0, min(vol, pos_room, vol_room))

    @staticmethod
    def hits_own(side, price, orders):
        if side == "bid":
            return any(o.side == "ask" and o.price <= price + EPS for o in orders.values())
        return any(o.side == "bid" and o.price >= price - EPS for o in orders.values())

    # ---------------- orders ----------------
    def _delete(self, iid, oid, orders):
        try:
            resp = self.ex.delete_order(iid, order_id=oid)
        except Exception as ex:
            self.limiter.hit()
            log.warning(f"delete_order {iid} #{oid}: {ex}")
            return False
        self.limiter.hit()
        if not resp.success:
            log.warning(f"delete_order {iid} #{oid} failed: {resp.error_reason}")
            return False              # keep it in the snapshot: it may still rest
        orders.pop(oid, None)
        return True

    def order(self, iid, side, price, vol, pos, orders, tick):
        """One passive quote on `side`. Returns the order_id to keep, None, or RATE_LIMITED."""
        vol = int(vol)
        if vol <= 0:
            return None
        price = round_price(price, tick)
        same_side = {oid: o for oid, o in orders.items() if o.side == side}
        for oid, o in same_side.items():
            diff = (price - o.price) if side == "bid" else (o.price - price)   # > 0: resting is less aggressive
            if o.volume == vol and -EPS <= diff <= KEEP_TICKS * tick + EPS:
                return oid            # close enough, on the safe side: no requests, keeps queue spot
        near = [oid for oid, o in same_side.items() if abs(o.price - price) <= NEAR_TICKS * tick + EPS]
        if not self.limiter.ok(len(near) + 1):      # never cancel without budget to re-insert
            return RATE_LIMITED
        for oid in near:
            self._delete(iid, oid, orders)
        vol = self.room(side, vol, pos, orders)
        if vol <= 0 or self.hits_own(side, price, orders):
            return None
        try:
            resp = self.ex.insert_order(iid, price=price, volume=vol, side=side, order_type="limit")
        except Exception as ex:
            self.limiter.hit()
            log.error(f"insert_order {iid}: {ex}")
            return None
        self.limiter.hit()
        if not resp.success:
            log.warning(f"insert {iid} {side} {vol}@{price} rejected: {resp.error_reason}")
            return None
        orders[resp.order_id] = SimpleNamespace(price=price, volume=vol, side=side)
        return resp.order_id

    def reconcile(self, iid, side, keep, orders):
        """Cancel every same-side order except `keep`."""
        for oid in [oid for oid, o in orders.items() if o.side == side and oid != keep]:
            if not self.limiter.ok():
                log.warning(f"{iid} {side}: rate budget hit, stale #{oid} left for next loop")
                return
            self._delete(iid, oid, orders)

    def cancel_all(self, iid, attempts=3):
        """Fail-closed cancel. Ignores the rate limiter: pulling quotes always wins."""
        for _ in range(attempts):
            try:
                self.ex.delete_orders(iid)
                return True
            except Exception as ex:
                log.warning(f"cancel_all {iid}: {ex}")
                time.sleep(0.2)
        return False

    # ---------------- taker: trade the pair gap the leader opened ----------------
    def maybe_take(self, iid, fair, lead_driven, book, pos, orders, tick):
        p = PAIRS.get(iid)
        if not p or not p["take"] or iid in self.take_off or not lead_driven:
            return 0
        now = time.time()
        if now - self.t_start < TAKE_WARMUP_S or now - self.last_take.get(iid, 0.0) < TAKE_COOLDOWN_S:
            return 0
        best_bid, best_ask = book.bids[0].price, book.asks[0].price
        edge = max(TAKE_EDGE_BPS * 1e-4 * fair, tick)
        if fair - best_ask >= edge - EPS:            # buy every ask up to fair - edge
            side, sign = "bid", 1
            price = round(math.floor((fair - edge) / tick + EPS) * tick, 2)
            vol = min(TAKE_VOL, SOFT_POS_LIMIT - pos)
        elif best_bid - fair >= edge - EPS:          # sell every bid down to fair + edge
            side, sign = "ask", -1
            price = round(math.ceil((fair + edge) / tick - EPS) * tick, 2)
            vol = min(TAKE_VOL, SOFT_POS_LIMIT + pos)
        else:
            return 0
        in_way = [oid for oid, o in orders.items() if o.side != side and
                  (o.price <= price + EPS if side == "bid" else o.price >= price - EPS)]
        if not self.limiter.ok(len(in_way) + 1):
            return 0
        for oid in in_way:                           # our own stale opposite quotes: pull them first
            self._delete(iid, oid, orders)
        if self.hits_own(side, price, orders):
            return 0
        vol = self.room(side, int(vol), pos, orders)
        if vol <= 0:
            return 0
        try:
            resp = self.ex.insert_order(iid, price=price, volume=vol, side=side, order_type="ioc")
        except Exception as ex:
            self.limiter.hit()
            log.error(f"IOC {iid}: {ex}")
            return 0
        self.limiter.hit()
        self.last_take[iid] = now
        if not resp.success:
            log.warning(f"IOC {iid} {side} {vol}@{price} rejected: {resp.error_reason}")
            return 0
        self.take_ids.add(resp.order_id)
        log.info(f"{iid} TAKE {side} {vol} up to {price} (fair {fair:.3f}, best {best_ask if sign > 0 else best_bid})")
        return sign * vol

    # ---------------- fills, markouts, breakers ----------------
    def process_fills(self, iid, micro):
        try:
            trades = self.ex.poll_new_trades(iid)
        except Exception as ex:
            log.warning(f"poll_new_trades {iid}: {ex}")
            trades = []
        now = time.time()
        for t in trades:
            kind = "take" if t.order_id in self.take_ids else "make"
            self.pending[iid].append((now, kind, 1 if t.side == "bid" else -1, t.price))
            self.write_rows(FILL_FILE, [[iid, kind, t.side, t.price, t.volume, t.order_id, micro]])
        q = self.pending[iid]
        while q and now - q[0][0] >= MARKOUT_S:
            _, kind, sign, px = q.popleft()
            self.markouts[iid][kind].append(sign * (micro - px) / px * 1e4)
        tk = self.markouts[iid]["take"][-MARKOUT_WINDOW:]
        if iid not in self.take_off and len(tk) >= TAKE_MIN_N and sum(tk) / len(tk) < TAKE_FLOOR_BPS:
            self.take_off.add(iid)
            log.warning(f"{iid}: IOC BREAKER - avg {sum(tk) / len(tk):+.1f} bps over {len(tk)} IOC fills -> IOC off")
        mk = self.markouts[iid]["make"][-MARKOUT_WINDOW:]
        if iid not in self.make_off and len(mk) >= MAKE_MIN_N and sum(mk) / len(mk) < MAKE_FLOOR_BPS:
            self.make_off.add(iid)
            log.warning(f"{iid}: MAKE BREAKER - avg {sum(mk) / len(mk):+.1f} bps over {len(mk)} fills -> reduce-only quotes")

    def report_markouts(self):
        parts = [f"{iid} {k} n={len(v)} avg {sum(v) / len(v):+.1f}bps"
                 for iid, d in sorted(self.markouts.items()) for k, v in d.items() if v]
        if parts:
            log.info(f"MARKOUT ({MARKOUT_S:g}s): " + " | ".join(parts) +
                     (f" | IOC off: {sorted(self.take_off)}" if self.take_off else "") +
                     (f" | Make off: {sorted(self.make_off)}" if self.make_off else ""))

    # ---------------- one loop iteration ----------------
    def step(self, iid):
        raw = self.book(iid)
        orders = self.outstanding(iid)
        if raw is None or orders is None or self.positions is None:
            return False
        book = self.clean_book(raw, orders) or raw   # alone on a side -> raw book, never "stale"
        pos = self.positions.get(iid, 0)
        tick = self.ticks[iid]
        best_bid, best_ask = book.bids[0].price, book.asks[0].price
        micro = self.microprice(book)
        mkt_half = self.spreads[iid].update((best_ask - best_bid) / 2)

        prev = self.last_micro.get(iid)
        self.last_micro[iid] = micro
        if prev and abs(micro / prev - 1) > JUMP_PULL_PCT:
            self.pause_until[iid] = time.time() + JUMP_PAUSE_S
            log.warning(f"{iid}: own price {(micro / prev - 1) * 1e4:+.0f}bps in one loop -> quotes pulled {JUMP_PAUSE_S:g}s")

        self.process_fills(iid, micro)
        if self.last_pos.get(iid) is not None and pos != self.last_pos[iid]:
            log.info(f"{iid} FILL: position {self.last_pos[iid]} -> {pos} (micro {micro:.3f})")
        self.last_pos[iid] = pos

        fair, implied, lead_driven = self.fair_value(iid, micro)
        paused = time.time() < self.pause_until[iid]
        took = 0 if paused else self.maybe_take(iid, fair, lead_driven, book, pos, orders, tick)
        pos_eff = pos + took                          # worst case: the IOC filled completely

        bid, ask = self.quote_prices(iid, fair, micro, pos_eff, mkt_half, best_bid, best_ask, tick)
        bid_vol, ask_vol = self.quote_sizes(pos_eff)
        if iid in self.make_off:                      # make breaker: only quotes that shrink the position
            bid_vol = min(bid_vol, max(0, -pos_eff))
            ask_vol = min(ask_vol, max(0, pos_eff))
        if paused:                                    # jump protection: step out of the way
            bid_vol = ask_vol = 0
        for side, price, vol in (("bid", bid, bid_vol), ("ask", ask, ask_vol)):
            keep = self.order(iid, side, price, vol, pos_eff, orders, tick)
            if keep is not RATE_LIMITED:
                self.reconcile(iid, side, keep, orders)

        self.write_rows(LOG_FILE, [[iid, best_bid, best_ask, micro, fair, implied, int(lead_driven), mkt_half,
                                    bid, ask, bid_vol, ask_vol, pos, self.pnl,
                                    sum(o.volume for o in orders.values()), took, int(paused)]])
        return True

    def write_rows(self, name, rows):
        """Logging must never take the bot down."""
        try:
            self.exporter.export({name: [[fmt(v) for v in r] for r in rows]})
        except Exception as ex:
            log.warning(f"csv log failed: {ex}")

    # ---------------- lifecycle ----------------
    def preflight(self, iids):
        tradable = self.ex.get_tradable_instruments()
        needed = set(iids) | {p["leader"] for p in PAIRS.values()}
        for iid in sorted(needed):
            if iid not in tradable:
                raise ValueError(f"{iid} not tradable. Available: {sorted(tradable)}")
            self.ticks[iid] = tradable[iid].tick_size
            log.info(f"{iid}: tick={tradable[iid].tick_size}")
        if os.path.exists(STOP_FILE):
            os.remove(STOP_FILE)
            log.info(f"removed leftover {STOP_FILE} file")
        for iid in iids:
            self.cancel_all(iid)                      # clean slate
            try:
                self.ex.poll_new_trades(iid)          # drop fills from before this run
            except Exception:
                pass
        self.limiter.hit(len(iids))                   # those cancels count toward the 25/s
        self.write_rows(LOG_FILE, [LOG_COLUMNS])
        self.write_rows(FILL_FILE, [FILL_COLUMNS])
        log.info(f"Logging to exports/{LOG_FILE} and exports/{FILL_FILE}")

    def kill_reason(self):
        if os.path.exists(STOP_FILE):
            return f"{STOP_FILE} file present"
        if self.bad_loops and all(self.bad_loops.get(i, 0) >= MAX_BAD_LOOPS for i in INSTRUMENTS):
            return f"no usable data on any name for {MAX_BAD_LOOPS} loops"
        for iid, pos in self.last_pos.items():
            if abs(pos) > POS_LIMIT:
                return f"{iid}: |position| {pos} above limit {POS_LIMIT}"
        if self.pnl is not None and self.pnl_peak is not None and self.pnl_peak - self.pnl > MAX_DRAWDOWN:
            return f"drawdown {self.pnl_peak - self.pnl:.1f} above {MAX_DRAWDOWN}"
        return None

    def try_reconnect(self, attempts=3):
        """Optibook refuses connect() twice on one object -> a NEW Exchange each attempt.
        Kicked because another process logged in? This kicks it back: run ONE bot only."""
        for i in range(attempts):
            time.sleep(2.0)
            try:
                try:
                    self.ex.disconnect()
                except Exception:
                    pass
                ex = Exchange()
                ex.connect()
                if ex.is_connected():
                    self.ex = ex
                    for iid in INSTRUMENTS:
                        self.cancel_all(iid)
                    log.warning("Reconnected with a new client.")
                    return True
            except Exception as ex:
                log.error(f"reconnect {i + 1}/{attempts} failed: {ex}")
        return False

    def shutdown(self, iids):
        """Always runs. Cancels everything, verifies, reports, disconnects. POSITIONS STAY."""
        log.info("Shutting down: cancelling all orders.")
        if not self.ex.is_connected():
            log.warning("Not connected: the exchange cancels a dropped session's orders; positions stay.")
            self.report_markouts()
            return
        for iid in iids:
            self.cancel_all(iid)
        for iid in iids:
            left = self.outstanding(iid)
            if left is None:
                log.error(f"{iid}: could not verify that no orders are resting")
            elif left:
                log.error(f"{iid}: {len(left)} orders still resting, deleting one by one")
                for oid in left:
                    try:
                        self.ex.delete_order(iid, order_id=oid)
                    except Exception as ex:
                        log.error(f"delete_order {iid} #{oid}: {ex}")
            else:
                log.info(f"{iid}: no resting orders.")
        self.report_markouts()
        try:
            log.info(f"Final positions: {self.ex.get_positions()}  PnL: {self.ex.get_pnl()}")
        except Exception as ex:
            log.warning(f"final report failed: {ex}")
        try:
            self.ex.disconnect()
        except Exception as ex:
            log.warning(f"disconnect: {ex}")

    def run(self, iids):
        dt = 1.0 / LOOP_HZ
        try:
            self.preflight(iids)
            while True:
                t0 = time.time()
                reason = self.kill_reason()
                if reason:
                    log.error(f"KILL SWITCH: {reason}")
                    break
                if not self.ex.is_connected():
                    self.disconnects += 1
                    if self.disconnects > MAX_RECONNECTS or not self.try_reconnect():
                        log.error(f"KILL SWITCH: disconnected ({self.disconnects}x), not reconnecting")
                        break
                self.books = {}
                self.refresh_positions()
                self.refresh_pnl()
                order_ = iids[self.rotation:] + iids[:self.rotation]   # fair share of the rate budget
                self.rotation = (self.rotation + 1) % len(iids)
                for iid in order_:
                    ok = False
                    try:
                        ok = self.step(iid)
                    except Exception as ex:
                        log.error(f"step {iid}: {ex}")
                    self.bad_loops[iid] = 0 if ok else self.bad_loops[iid] + 1
                    if self.bad_loops[iid] == STALE_CANCEL_LOOPS:
                        log.warning(f"{iid}: no usable data for {STALE_CANCEL_LOOPS} loops, pulling quotes")
                        self.cancel_all(iid)
                if time.time() - self.last_report >= REPORT_S:
                    self.report_markouts()
                    self.last_report = time.time()
                time.sleep(max(0.0, dt - (time.time() - t0)))
        finally:
            self.shutdown(iids)


if __name__ == "__main__":
    signal.signal(signal.SIGTERM, _raise_interrupt)
    MarketMaker().run(INSTRUMENTS)
